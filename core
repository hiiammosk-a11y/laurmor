        local podiumsFolder = plot:FindFirstChild("AnimalPodiums")
        local pod = podiumsFolder and podiumsFolder:FindFirstChild(tostring(podiumName))
        if pod then
            for _, d in ipairs(pod:GetDescendants()) do
                if d:IsA("TextLabel") and d.Text and d.Text ~= "" and d.Text ~= "$0" then
                    if string.find(d.Text, "/s", 1, true) or string.find(d.Text, "/S", 1, true) then
