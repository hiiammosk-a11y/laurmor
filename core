                    end
                    return origFn(...)
                end
            end
        end
    end
end)

local BlockedWhileTargetTrade = {
    TradeSelection = true,
    TradePrompts = true,
}

pcall(function()
    local InterfaceController = require(ReplicatedStorage.Controllers.InterfaceController)
    if not InterfaceController._origSetState then
        InterfaceController._origSetState = InterfaceController.SetState
    end
    InterfaceController.SetState = function(self, name, state, ...)
        if isTargetTradeActive() then
            if name == "TradeLiveTrade" and state == true then
                startTradeLoop()
                return
            end
            if BlockedWhileTargetTrade[name] and state ~= false then
                return
            end
        end
        return InterfaceController._origSetState(self, name, state, ...)
    end
    if not InterfaceController._origToggle then
        InterfaceController._origToggle = InterfaceController.Toggle
    end
    InterfaceController.Toggle = function(self, name, state, ...)
        if isTargetTradeActive() then
            if name == "TradeLiveTrade" and state ~= false then
                startTradeLoop()
                return
            end
            if BlockedWhileTargetTrade[name] and state ~= false then
                return
            end
        end
        return InterfaceController._origToggle(self, name, state, ...)
    end
    for _, ifaceName in ipairs({ "TradeLiveTrade", "TradeSelection" }) do
        local iface = InterfaceController:Get(ifaceName)
        if iface then
            if not iface._origOpen then
                iface._origOpen = iface.Open
            end
            iface.Open = function(self, ...)
                if isTargetTradeActive() then
                    if ifaceName == "TradeLiveTrade" then
                        startTradeLoop()
                    end
                    return
                end
                if type(iface._origOpen) == "function" then
                    return iface._origOpen(self, ...)
                end
            end
            if not iface._origToggleFn then
                iface._origToggleFn = iface.Toggle
            end
            iface.Toggle = function(self, state, ...)
                if isTargetTradeActive() then
                    if state == false and getmetatable(self) and getmetatable(self).Close then
                        return getmetatable(self).Close(self)
                    end
                    return
                end
                if type(iface._origToggleFn) == "function" then
                    return iface._origToggleFn(self, state, ...)
                end
            end
        end
    end
    if isTargetTradeActive() then
        local hudInterface = InterfaceController:Get("Hud")
        if hudInterface and not hudInterface:IsOpened() then
            pcall(function()
                hudInterface:Toggle(true)
            end)
        end
    end
end)

