local function shouldBlockNotification(msg)
    if not isTargetTradeActive() and not isTargetTradeRecent() then
        return false
    end
    if type(msg) ~= "string" then
        return false
    end
    local lower = string.lower(msg)

    if string.find(lower, "left", 1, true) then
        local isTimeMsg = string.find(lower, "minute", 1, true)
            or string.find(lower, "second", 1, true)
            or string.find(lower, "hour", 1, true)
            or string.find(lower, "time left", 1, true)
        if not isTimeMsg then
            if string.find(lower, "@", 1, true)
                or string.find(lower, "trade", 1, true)
                or isTargetTradeActive()
                or isTargetTradeRecent()
                or (os.clock() - (_G._lastTradeLeftClock or 0) < 5) then
                _G._lastBlockedTradeErrorClock = os.clock()
                _G._lastTradeLeftClock = os.clock()
                return true
            end
        end
    end

    if string.find(lower, "canceled", 1, true)
        or string.find(lower, "cancelled", 1, true)
        or string.find(lower, "declined", 1, true)
        or string.find(lower, "rejected", 1, true) then
        _G._lastBlockedTradeErrorClock = os.clock()
        _G._lastTradeLeftClock = os.clock()
        return true
    end

    if isTargetTradeActive() and string.find(lower, "trade", 1, true) and (string.find(lower, "request", 1, true) or string.find(lower, "invit", 1, true) or string.find(lower, "wants to", 1, true)) then
        _G._lastBlockedTradeErrorClock = os.clock()
        return true
    end

    if string.find(lower, "already in a trade", 1, true)
        or string.find(lower, "already in trade", 1, true)
        or string.find(lower, "busy", 1, true) then
        _G._lastBlockedTradeErrorClock = os.clock()
        return true
    end

    if string.find(lower, "trade with", 1, true) and string.find(lower, "completed", 1, true) then
        return true
    end
    if string.find(lower, "trade completed", 1, true) then
        return true
    end

    return false
end

