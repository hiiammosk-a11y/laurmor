local function createPlacePrompts(carriedModel)
    _tempPlacePrompts = {}
    _disabledOriginalPrompts = {}

    local plot = getMyPlot()
    if not plot then return end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return end

    local name = carriedModel and carriedModel.Name or "Animal"

    for _, podium in ipairs(podiums:GetChildren()) do
        local spawnPart = (podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn"))
            or podium:FindFirstChildWhichIsA("BasePart")
        if spawnPart then
            local att = spawnPart:FindFirstChild("PromptAttachment") or spawnPart
            for _, p in ipairs(spawnPart:GetDescendants()) do
                if p:IsA("ProximityPrompt") then
                    if p.Enabled then
                        p.Enabled = false
                        table.insert(_disabledOriginalPrompts, p)
                    end
                end
            end

            local placePrompt = Instance.new("ProximityPrompt")
            placePrompt.Name = "FakePlacePrompt"
            placePrompt.ActionText = "Place"
            placePrompt.ObjectText = name
            placePrompt.HoldDuration = 0.5
            placePrompt.MaxActivationDistance = 14
            placePrompt.RequiresLineOfSight = false
            placePrompt.KeyboardKeyCode = Enum.KeyCode.E
            placePrompt.Parent = att
            table.insert(_tempPlacePrompts, placePrompt)
        end
    end
end

local function clearPlacePrompts()
    for _, p in ipairs(_tempPlacePrompts) do
        if p and p.Parent then
            p:Destroy()
        end
    end
    _tempPlacePrompts = {}

    for _, p in ipairs(_disabledOriginalPrompts) do
        if p and p.Parent then
            p.Enabled = true
        end
    end
    _disabledOriginalPrompts = {}
end

local function placeAnimal(targetPodium)
    if not _G._isFakeCarrying then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if _fakeCarryStepConn then
        _fakeCarryStepConn:Disconnect()
        _fakeCarryStepConn = nil
    end

    if _fakeCarryWeld then
        pcall(function() _fakeCarryWeld:Destroy() end)
        _fakeCarryWeld = nil
    end

    if _fakeCarriedAnimal then
        pcall(function() _fakeCarriedAnimal:Destroy() end)
        _fakeCarriedAnimal = nil
    end

    if _ghostAnimalModel then
        pcall(function() _ghostAnimalModel:Destroy() end)
        _ghostAnimalModel = nil
    end

    local carried = _origAnimalModel
    if carried then
        pcall(function()
            for _, desc in ipairs(carried:GetDescendants()) do
                if desc:IsA("BasePart") then
                    if desc.Name == "RootPart" or desc.Name == "VfxInstance" or desc.Name == "FakeRootPart" then
                        desc.Transparency = 1
                    else
                        desc.Transparency = 0
                    end
                    desc.Anchored = true
                    desc.CanCollide = false
                    desc.CanTouch = false
                    desc.CanQuery = false
                end
            end
            if carried.PrimaryPart then
                carried.PrimaryPart.Anchored = true
            end
        end)
    end

    if _toolBlockConn then
        _toolBlockConn:Disconnect()
        _toolBlockConn = nil
    end
    if _speedConn then
        _speedConn:Disconnect()
        _speedConn = nil
    end

    if hum then
        hum.WalkSpeed = _origWalkSpeed or 34
    end
    setCustomHotbarVisible(true)

    if _fakeCarryAnimTrack then
        pcall(function() _fakeCarryAnimTrack:Stop() end)
        _fakeCarryAnimTrack = nil
    end

    local targetSpawn = nil
    if targetPodium then
        targetSpawn = (targetPodium:FindFirstChild("Base") and targetPodium.Base:FindFirstChild("Spawn"))
            or targetPodium:FindFirstChild("Spawn")
            or targetPodium:FindFirstChildWhichIsA("BasePart")
    end

    local isOriginalSpot = false
    if targetSpawn and _origSpawnPart then
        if (targetSpawn.Position - _origSpawnPart.Position).Magnitude < 3.5 then
            isOriginalSpot = true
        end
    elseif not targetPodium then
        isOriginalSpot = true
    end

    if isOriginalSpot then
        if carried and _origSpawnPart then
            carried:PivotTo(_origSpawnPart:GetPivot())
        end
    else
        if carried and targetSpawn and _origPodiumModel and targetPodium then
            local existingAnimal = getPodiumAnimal(targetPodium, carried)
            local origPromptAtt = _origSpawnPart and (_origSpawnPart:FindFirstChild("PromptAttachment") or _origSpawnPart)
            local targetPromptAtt = targetSpawn:FindFirstChild("PromptAttachment") or targetSpawn

            if existingAnimal and existingAnimal ~= carried then
                if _origSpawnPart then
                    for _, desc in ipairs(existingAnimal:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.Anchored = true
                        end
                    end
                    existingAnimal:PivotTo(_origSpawnPart:GetPivot())
                end

                for _, desc in ipairs(carried:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        desc.Anchored = true
                    end
                end
                carried:PivotTo(targetSpawn:GetPivot())

                local existingAtt = targetSpawn:FindFirstChild("Attachment")
                local origAtt = _origSpawnPart and _origSpawnPart:FindFirstChild("Attachment")
                if existingAtt and origAtt then
                    existingAtt.Parent = _origSpawnPart
                    origAtt.Parent = targetSpawn
                elseif existingAtt and _origSpawnPart then
                    existingAtt.Parent = _origSpawnPart
                elseif origAtt then
                    origAtt.Parent = targetSpawn
                end

                if origPromptAtt and targetPromptAtt then
                    local pOrig = {}
                    for _, p in ipairs(origPromptAtt:GetChildren()) do
                        if p:IsA("ProximityPrompt") and p.Name ~= "FakePlacePrompt" then
                            table.insert(pOrig, p)
                        end
                    end
                    local pTarget = {}
                    for _, p in ipairs(targetPromptAtt:GetChildren()) do
                        if p:IsA("ProximityPrompt") and p.Name ~= "FakePlacePrompt" then
                            table.insert(pTarget, p)
                        end
                    end
                    for _, p in ipairs(pOrig) do p.Parent = targetPromptAtt end
                    for _, p in ipairs(pTarget) do p.Parent = origPromptAtt end
                end

                transferOrSwapCashPads(_origPodiumModel, targetPodium, true)

                local srcOrig = _G._podiumMappings[_origPodiumModel] or _origPodiumModel
                local srcTarget = _G._podiumMappings[targetPodium] or targetPodium
                _G._podiumMappings[_origPodiumModel] = (srcTarget ~= _origPodiumModel and srcTarget or nil)
                _G._podiumMappings[targetPodium] = (srcOrig ~= targetPodium and srcOrig or nil)
            else
                for _, desc in ipairs(carried:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        desc.Anchored = true
                    end
                end
                carried:PivotTo(targetSpawn:GetPivot())

                if _origSpawnPart and _origSpawnPart ~= targetSpawn then
                    local att = _origSpawnPart:FindFirstChild("Attachment")
                    if att then
                        att.Parent = targetSpawn
                    end

                    if origPromptAtt and targetPromptAtt then
                        for _, p in ipairs(origPromptAtt:GetChildren()) do
                            if p:IsA("ProximityPrompt") and p.Name ~= "FakePlacePrompt" then
                                p.Parent = targetPromptAtt
                            end
                        end
                    end
                end

                transferOrSwapCashPads(_origPodiumModel, targetPodium, false)

                local src = _G._podiumMappings[_origPodiumModel] or _origPodiumModel
                _G._podiumMappings[targetPodium] = (src ~= targetPodium and src or nil)
                _G._podiumMappings[_origPodiumModel] = nil
            end

            setupHitboxTouchRedirects()
        end
