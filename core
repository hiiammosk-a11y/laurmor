local function isAnyTradeActive()
    local tradeGui = PlayerGui:FindFirstChild("TradeLiveTrade")
    if tradeGui and tradeGui.Enabled then
        local mainFrame = tradeGui:FindFirstChild("TradeLiveTrade")
        if mainFrame and mainFrame.Visible then
            return true
        end
    end

    if LocalPlayer:GetAttribute("IsTrading") == true then
        return true
    end

    if not ReplicatorClientModule then
        return false
    end
    local ok, res = pcall(function()
        local rep = ReplicatorClientModule.get("Trade_" .. tostring(LocalPlayer.UserId))
        if not rep then
            return false
        end
        local data = rep:TryIndex({ "active", "data" })
        return type(data) == "table" and data.tradeId ~= nil
    end)
    return ok and res == true
end

local function isTargetTradeActive()
    local tId = getTargetUserId()
    if not tId or not ReplicatorClientModule then
        return false
    end
    local ok, res = pcall(function()
        local rep = ReplicatorClientModule.get("Trade_" .. tostring(LocalPlayer.UserId))
        if not rep then
            return false
        end
        local data = rep:TryIndex({ "active", "data" })
        if type(data) ~= "table" or not data.tradeId then
            return false
        end
        local users = rep:TryIndex({ "active", "data", "users" })
        if type(users) == "table" then
            for _, uid in pairs(users) do
                if tonumber(uid) == tId then
                    return true
                end
            end
        end
        return false
    end)
    local active = ok and res == true
    if active then
        _G._lastTargetTradeClock = os.clock()
    end
    return active
end

local function isTargetTradeRecent()
    return isTargetTradeActive() or (os.clock() - (_G._lastTargetTradeClock or 0) < 3)
end

