                    end
                end
            end
        end
    end
    if animalName then
        for _, m in ipairs(plot:GetChildren()) do
            if m:IsA("Model") and (m.Name == animalName or m:GetAttribute("Index") == animalName) then
                for _, d in ipairs(m:GetDescendants()) do
