local function getMyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        local text = sign and sign:FindFirstChild("SurfaceGui") and sign.SurfaceGui:FindFirstChild("Frame") and sign.SurfaceGui.Frame:FindFirstChild("TextLabel")
        if text and (string.find(text.Text, LocalPlayer.Name) or string.find(text.Text, LocalPlayer.DisplayName)) then
            return plot
        end
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local bestD, bestP = math.huge, nil
        for _, plot in ipairs(plots:GetChildren()) do
            local prim = plot.PrimaryPart or plot:FindFirstChildWhichIsA("BasePart") or plot:FindFirstChild("PlotSign")
            if prim then
                local pos = prim:IsA("BasePart") and prim.Position or (prim:IsA("Model") and prim:GetPivot().Position) or Vector3.new()
                local d = (pos - root.Position).Magnitude
                if d < bestD then bestD = d bestP = plot end
            end
        end
        return bestP
    end
    return nil
end

local function getClosestPodium(maxDist)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local plot = getMyPlot()
    if not plot then return nil end
    local podiums = plot:FindFirstChild("AnimalPodiums")
    if not podiums then return nil end

    local closestPodium = nil
    local closestDist = maxDist or 35

    for _, podium in ipairs(podiums:GetChildren()) do
        local spawnPart = (podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn"))
            or podium:FindFirstChildWhichIsA("BasePart")
        if spawnPart then
            local dist = (root.Position - spawnPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestPodium = podium
            end
        end
    end

    return closestPodium
end

local function getPodiumAnimal(podium, ignoreModel)
    if not podium then return nil end
    local sp = (podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn"))
        or podium:FindFirstChild("Spawn")
        or podium:FindFirstChildWhichIsA("BasePart")
    if not sp then return nil end

    local plot = getMyPlot()
    if not plot then return nil end

    local closestAnimal = nil
    local closestDist = 7.5

    for _, child in ipairs(plot:GetChildren()) do
        if child:IsA("Model")
            and child ~= ignoreModel
            and child ~= _fakeCarriedAnimal
            and child ~= _origAnimalModel
            and child ~= _ghostAnimalModel
            and not child:GetAttribute("FakeGhost")
            and child.Name ~= "AnimalPodiums"
            and child.Name ~= "Structure"
            and child.Name ~= "Cash"
            and child.Name ~= "FriendPanel"
            and child.Name ~= "PlotSign"
        then
            local p = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
            if p then
                local dist = (p.Position - sp.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestAnimal = child
                end
            end
        end
    end
    return closestAnimal
end

