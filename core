local function normalizeStr(str)
    if type(str) ~= "string" then
        return ""
    end
    local cleaned = string.gsub(str, "['`’\"_%-]", "")
    cleaned = string.gsub(cleaned, "%s+", "")
    return string.lower(cleaned)
end

local function matchesList(text, list)
    local normText = normalizeStr(text)
    if normText == "" then
        return false
    end
    for _, target in ipairs(list) do
        local normTarget = normalizeStr(target)
        if normTarget ~= "" then
            if normText == normTarget or string.find(normText, normTarget, 1, true) or string.find(normTarget, normText, 1, true) then
                return true
            end
        end
    end
    return false
end

local function isTargetAnimal(brainrotRecord)
    local indexName = ""
    if typeof(brainrotRecord) == "Instance" then
        indexName = tostring(brainrotRecord:GetAttribute("Index") or brainrotRecord.Name or "")
    elseif type(brainrotRecord) == "table" then
        indexName = tostring(brainrotRecord.Index or brainrotRecord.Name or "")
    elseif type(brainrotRecord) == "string" then
        indexName = brainrotRecord
    else
        return false
    end
    if matchesList(indexName, TargetAnimals) then
        return true
    end
    local animalMeta = AnimalsData[indexName]
    if type(animalMeta) == "table" then
        local displayName = tostring(animalMeta.DisplayName or animalMeta.Name or "")
        if matchesList(displayName, TargetAnimals) then
            return true
        end
    end
    return false
end

local function isTargetBase(skinRecord)
    local skinName = type(skinRecord) == "table" and tostring(skinRecord.SkinName or skinRecord.Name or "") or tostring(skinRecord or "")
    if matchesList(skinName, TargetBases) then
