local function isPodiumInert(podium)
    local map = _G._podiumMappings
    if map[podium] ~= nil then return false end
    for _, src in pairs(map) do
        if src == podium then return true end
    end
    return false
end

local function podiumOfInstance(inst, podiumsFolder)
    local cur = inst
    while cur and cur.Parent and cur.Parent ~= podiumsFolder do
        cur = cur.Parent
    end
    if cur and cur.Parent == podiumsFolder then
        return cur
    end
    return nil
end

local function isSteppingOnPad(mainPart, hitboxPart, rootPart)
    if not rootPart then return false end
    local refPart = mainPart or hitboxPart
    if not refPart then return false end

    local rPos = rootPart.Position
    local mPos = refPart.Position

    local dx = rPos.X - mPos.X
    local dz = rPos.Z - mPos.Z
    local dy = math.abs(rPos.Y - mPos.Y)

    if (dx * dx + dz * dz) <= 38.44 and dy <= 6.5 then
        return true
    end

    if hitboxPart then
        local rel = hitboxPart.CFrame:PointToObjectSpace(rPos)
        local h = hitboxPart.Size / 2
        if math.abs(rel.X) <= h.X + 2.0 and math.abs(rel.Z) <= h.Z + 2.0 and math.abs(rel.Y) <= h.Y + 5.5 then
            return true
        end
    end
    return false
end

local function setPadLook(main, look)
    if main.Color ~= look.Color then main.Color = look.Color end
    if main.Material ~= look.Material then main.Material = look.Material end
end

local function redirectCashOverheads(podiumsFolder)
    local ok, FastOverheadController = pcall(function()
        return require(ReplicatedStorage.Controllers.FastOverheadController)
    end)
    if not ok or not FastOverheadController then return end
    local okU, uv3 = pcall(debug.getupvalue, FastOverheadController.createFastOverhead, 3)
    if not okU or type(uv3) ~= "table" then return end

    local map = _G._podiumMappings
    for _, entry in pairs(uv3) do
        if type(entry) == "table" and entry.gui and entry.gui.Name == "CashPad" and typeof(entry.adornee) == "Instance" then
            local home
            if entry._fakeLast ~= nil and entry._fakeLast == entry.adornee then
                home = entry._fakeHome
            else
                home = podiumOfInstance(entry.adornee, podiumsFolder)
                entry._fakeHome = home
            end
            if home then
                local desired = home
                for k, v in pairs(map) do
                    if v == home then
                        desired = k
                        break
                    end
                end
                local desiredMain = getClaimParts(desired)
                if desiredMain and entry.adornee ~= desiredMain then
                    entry.adornee = desiredMain
                    entry.adorneePosition = desiredMain.Position
                end
                entry._fakeLast = desiredMain or entry.adornee
            end
        end
    end
end

local function padSync()
    if not isTargetTradeActive() and not _G._isFakeCarrying then
        for hitbox, origCanTouch in pairs(_blockedHitbox) do
            if hitbox and hitbox.Parent then
                pcall(function() hitbox.CanTouch = origCanTouch end)
            end
        end
        _blockedHitbox = {}
        return
    end

    local plot = getMyPlot()
    if not plot then return end
    local podiumsFolder = plot:FindFirstChild("AnimalPodiums")
    if not podiumsFolder then return end
    local map = _G._podiumMappings

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local now = os.clock()

    for _, podium in ipairs(podiumsFolder:GetChildren()) do
        local main, hitbox = getClaimParts(podium)
        local src = map[podium]

        if hitbox then
            local shouldBlock = (src ~= nil) or isPodiumInert(podium)
            if shouldBlock then
                if _blockedHitbox[hitbox] == nil then
                    _blockedHitbox[hitbox] = hitbox.CanTouch
                end
                if hitbox.CanTouch then hitbox.CanTouch = false end
            elseif _blockedHitbox[hitbox] ~= nil then
                hitbox.CanTouch = _blockedHitbox[hitbox]
                _blockedHitbox[hitbox] = nil
            end
        end

        if main then
            if src ~= nil and src ~= podium and src.Parent then
                local srcMain = getClaimParts(src)
                if srcMain then
                    if not _padLook[podium] then
                        _padLook[podium] = { Color = main.Color, Material = main.Material }
                    end
                    setPadLook(main, _padLook[src] or { Color = srcMain.Color, Material = srcMain.Material })
                end
            elseif _padLook[podium] then
                setPadLook(main, _padLook[podium])
                _padLook[podium] = nil
            end
        end

        if src ~= nil and src ~= podium and src.Parent and root then
            local isBeingCarried = (_G._isFakeCarrying and _origPodiumModel == podium)
            if not isBeingCarried then
                local inside = isSteppingOnPad(main, hitbox, root)
                local last = _claimInside[podium] or 0

                if inside and (not _claimWasInside[podium] or now - last >= 0.7) then
                    _claimInside[podium] = now
                    local idx = tonumber(src.Name)
                    if idx then
                        local rem = getClaimCoinsRemote()
                        if rem then
                            pcall(function() rem:FireServer(idx) end)
                        end

                        local played = false
                        pcall(function()
                            local sc = require(ReplicatedStorage.Controllers.SoundController)
                            if sc and sc.PlaySound then
                                sc:PlaySound("Sounds.Sfx.Cashout")
                                played = true
                            end
                        end)
                        if not played then
                            pcall(function()
                                local cashSound = ReplicatedStorage:FindFirstChild("Sounds")
                                    and ReplicatedStorage.Sounds:FindFirstChild("Sfx")
                                    and ReplicatedStorage.Sounds.Sfx:FindFirstChild("Cashout")
                                if cashSound then
                                    game:GetService("SoundService"):PlayLocalSound(cashSound)
                                end
                            end)
                        end

                        pcall(function()
                            local FastOverheadController = require(ReplicatedStorage.Controllers.FastOverheadController)
                            local uv3 = debug.getupvalue(FastOverheadController.createFastOverhead, 3)
                            if type(uv3) == "table" then
                                for _, entry in pairs(uv3) do
                                    if entry and entry.gui and entry.gui.Name == "CashPad" and (entry.adornee == main or (hitbox and entry.adornee == hitbox)) then
                                        for _, d in ipairs(entry.gui:GetDescendants()) do
                                            if d:IsA("TextLabel") and (string.find(d.Text, "%$") or string.find(d.Text, "%d")) then
                                                d.Text = "$0"
                                            end
                                        end
                                    end
                                end
                            end
                        end)
                    end
                end
                _claimWasInside[podium] = inside
            else
                _claimWasInside[podium] = nil
            end
        else
            _claimWasInside[podium] = nil
        end
    end

    redirectCashOverheads(podiumsFolder)
end

