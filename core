local function getAnimalFullIncome(b)
    if not b then return 0, nil end
    local meta = b.meta or AnimalsData[b.index] or AnimalsData[b.displayName]

    local plotOverhead = getPlotOverheadIncome(b.podium, b.displayName or b.index)
    local rawVal = plotOverhead

    if not rawVal and b.rawBrainrot and type(b.rawBrainrot) == "table" then
        local br = b.rawBrainrot
        rawVal = br.Income or br.income or br.Generation or br.generation or br.CashPerSecond or br.cashPerSecond or br.BaseIncome or br.baseIncome or br.Cash or br.cash or br.Rate or br.rate
    end

    if not rawVal and meta and type(meta) == "table" then
        rawVal = meta.Income or meta.income or meta.BaseIncome or meta.baseIncome or meta.CashPerSecond or meta.cashPerSecond or meta.Generation or meta.generation or meta.Cash or meta.cash or meta.Rate or meta.rate or meta.Value or meta.value
    end

    local numVal = parseIncomeValue(rawVal)
    local lookupName = (meta and (meta.DisplayName or meta.Name)) or b.displayName or b.index or ""
    local wikiInfo = fetchWikiAnimal(lookupName, b.mutation)

    if numVal <= 0 and wikiInfo and wikiInfo.income then
        numVal = parseIncomeValue(wikiInfo.income)
    end

    local mult = 1
    if not plotOverhead then
        mult = getMutationMultiplier(b.mutation)
    end

    local finalIncome = numVal * mult
    return finalIncome, wikiInfo
end

