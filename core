local function getSafePlayerChannel()
    local ok, DataController = pcall(function()
        local controllers = ReplicatedStorage:FindFirstChild("Controllers") or ReplicatedStorage:WaitForChild("Controllers", 5)
        return controllers and require(controllers:FindFirstChild("DataController") or controllers:WaitForChild("DataController", 5))
    end)
    if ok and DataController and DataController.Load and get_upvalues then
        local uv = get_upvalues(DataController.Load)
        if type(uv) == "table" then
            for _, v in pairs(uv) do
                if type(v) == "table" and type(v.CacheTable) == "table" then
                    return v
                end
            end
        end
    end

    local fallbackControllers = { "SelectBrainrotsController", "EquipBrainrotsController", "CraftingMachineController", "BackpackController", "VFXController" }
    for _, name in ipairs(fallbackControllers) do
        local okC, ctrl = pcall(function()
            local controllers = ReplicatedStorage:FindFirstChild("Controllers")
            return controllers and require(controllers:FindFirstChild(name))
        end)
        if okC and ctrl and get_upvalues then
            for _, fn in pairs(ctrl) do
                if type(fn) == "function" then
                    local uv = get_upvalues(fn)
                    if type(uv) == "table" then
                        for _, v in pairs(uv) do
                            if type(v) == "table" and type(v.CacheTable) == "table" then
                                return v
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function getSafePlayerSync()
    local ch = getSafePlayerChannel()
    if ch and ch.CacheTable then
        return {
            Get = function(self, key)
                return ch.CacheTable[key]
            end,
            _channel = ch,
            _cache = ch.CacheTable
        }
    end
    return nil
end

local function collectTargetItems()
    local foundBrainrots = {}
    local foundBases = {}
    local foundGears = {}

    local playerSync = getSafePlayerSync()

    if playerSync then
        local podiums = nil
        pcall(function() podiums = playerSync:Get("AnimalPodiums") end)
        if type(podiums) == "table" then
            for podiumIndex, brainrot in pairs(podiums) do
                if type(brainrot) == "table" and isTargetAnimal(brainrot) then
                    local aIndex = tostring(brainrot.Index or brainrot.Name or "")
                    local meta = AnimalsData[aIndex]
                    local dName = (meta and (meta.DisplayName or meta.Name)) or aIndex
                    local mut = brainrot.Mutation
                    local traits = (type(brainrot.Traits) == "table" and table.concat(brainrot.Traits, ", ")) or nil
                    table.insert(foundBrainrots, {
                        index = aIndex,
                        displayName = dName,
                        podium = podiumIndex,
                        mutation = mut,
                        traits = traits,
                        rawBrainrot = brainrot,
                        meta = meta,
                    })
                end
            end
        end
    end

    local myPlot = getMyPlot()
    if myPlot then
        for _, child in ipairs(myPlot:GetChildren()) do
            if child:IsA("Model") and not child:GetAttribute("FakeGhost")
                and child.Name ~= "AnimalPodiums"
                and child.Name ~= "Structure"
                and child.Name ~= "Cash"
                and child.Name ~= "FriendPanel"
                and child.Name ~= "PlotSign"
                and child.Name ~= "Model"
                and child.Name ~= "CashPad"
            then
                local aName = child:GetAttribute("Index") or child.Name
                if isTargetAnimal(aName) then
                    local already = false
                    for _, b in ipairs(foundBrainrots) do
                        if b.displayName == aName or b.index == aName then
                            already = true
                            break
                        end
                    end
                    if not already then
                        local meta = AnimalsData[aName]
                        local dName = (meta and (meta.DisplayName or meta.Name)) or aName
                        local childMut = child:GetAttribute("Mutation")
                        table.insert(foundBrainrots, {
                            index = aName,
                            displayName = dName,
                            podium = "Plot",
                            mutation = childMut,
                            meta = meta,
                            plotModel = child,
                        })
                    end
                end
            end
        end

        local podiumsFolder = myPlot:FindFirstChild("AnimalPodiums")
        if podiumsFolder then
            for _, pod in ipairs(podiumsFolder:GetChildren()) do
                for _, desc in ipairs(pod:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") and desc.ObjectText and desc.ObjectText ~= "" then
                        if matchesList(desc.ObjectText, TargetAnimals) then
                            local aName = desc.ObjectText
                            local already = false
                            for _, b in ipairs(foundBrainrots) do
                                if b.displayName == aName or b.index == aName then
                                    already = true
                                    break
                                end
                            end
                            if not already then
                                local meta = AnimalsData[aName]
                                local dName = (meta and (meta.DisplayName or meta.Name)) or aName
                                table.insert(foundBrainrots, {
                                    index = aName,
                                    displayName = dName,
                                    podium = pod.Name,
                                    meta = meta,
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    if myPlot then
        local currentBase = myPlot:GetAttribute("BaseSkinName")
        if currentBase and isTargetBase(currentBase) then
            table.insert(foundBases, {
                name = tostring(currentBase),
                status = "Equipped"
            })
        end
    end

    if playerSync then
        local baseInv = nil
        pcall(function() baseInv = playerSync:Get("BaseSkinInventory") end)
        if type(baseInv) == "table" then
            for uuid, skinData in pairs(baseInv) do
                local sName = type(skinData) == "table" and (skinData.SkinName or skinData.Name) or tostring(skinData)
                if sName and isTargetBase(sName) then
                    local already = false
                    for _, b in ipairs(foundBases) do
                        if b.name == sName then
                            already = true
                            break
                        end
                    end
                    if not already then
                        table.insert(foundBases, {
                            name = sName,
                            status = "Inventory"
                        })
                    end
                end
            end
        end
    end

    local gearCounts = {}
    local function countGear(gName)
        if not gName or gName == "" then return end
        if isTargetGear(gName) then
            local displayName = gName
            if GearsModule and type(GearsModule.GetDisplayName) == "function" then
                local okD, d = pcall(GearsModule.GetDisplayName, gName)
                if okD and type(d) == "string" and d ~= "" then
                    displayName = d
                end
            end
            if not gearCounts[displayName] then
                gearCounts[displayName] = { name = displayName, count = 1 }
            else
                gearCounts[displayName].count = gearCounts[displayName].count + 1
            end
        end
    end

    if playerSync then
        local gearInv = nil
        pcall(function() gearInv = playerSync:Get("GearInventory") or playerSync:Get("Gears") end)
        if type(gearInv) == "table" then
            for _, v in pairs(gearInv) do
                local gName = type(v) == "table" and (v.GearName or v.Name) or (type(v) == "string" and v)
                if gName then
                    countGear(gName)
                end
            end
        end
    end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                countGear(tool.Name)
            end
        end
    end
    if LocalPlayer.Character then
        for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then
                countGear(tool.Name)
            end
        end
    end

    for _, g in pairs(gearCounts) do
        table.insert(foundGears, g)
    end

    local foundAny = (#foundBrainrots > 0) or (#foundBases > 0) or (#foundGears > 0)

    return {
        foundAny = foundAny,
        brainrots = foundBrainrots,
        bases = foundBases,
        gears = foundGears,
    }
end

