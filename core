    return false
end

local function isTargetGear(gearRecord)
    local gearName = type(gearRecord) == "table" and tostring(gearRecord.GearName or gearRecord.Name or "") or tostring(gearRecord or "")
    if matchesList(gearName, TargetGears) then
        return true
