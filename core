local function parseIncomeValue(val)
    if type(val) == "number" then
        return val
    end
    if type(val) ~= "string" or val == "" then
        return 0
    end
    local clean = string.upper(val)
    clean = string.gsub(clean, "[%$%s%,%/S]", "")
    local numStr, unit = string.match(clean, "^([%d%.]+)([KMBT]?)$")
    if numStr then
        local n = tonumber(numStr) or 0
        if unit == "K" then
            return n * 1e3
        elseif unit == "M" then
            return n * 1e6
        elseif unit == "B" then
            return n * 1e9
        elseif unit == "T" then
            return n * 1e12
        else
            return n
        end
    end
    return tonumber(clean) or 0
end

