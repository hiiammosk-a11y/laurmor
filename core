    if GearsModule and type(GearsModule.GetDisplayName) == "function" and gearName ~= "" then
        local ok, display = pcall(GearsModule.GetDisplayName, gearName)
        if ok and type(display) == "string" and matchesList(display, TargetGears) then
            return true
        end
    end
    return false
end

