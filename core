local automationRunning = false

local function startTradeLoop()
    if automationRunning then
        return
    end
    if not isTargetTradeActive() then
        return
    end
    automationRunning = true
    _G._isTradeActive = true

    task.spawn(function()
        pcall(function()
            local ReplicatorClient = require(ReplicatedStorage.Packages.ReplicatorClient)
            local tradeRep = ReplicatorClient.get("Trade_" .. tostring(LocalPlayer.UserId))
            local playerSync = getSafePlayerSync()
            if not tradeRep or not playerSync then
                return
            end

            local lastTradeId = nil
            local lastActionClock = 0
            local lastAttemptTimes = {}

            while _G._tradeScriptRunId == currentRunId do
                local activeData = tradeRep:TryIndex({ "active", "data" })
                if type(activeData) ~= "table" or not activeData.tradeId then
                    break
                end

                if not isTargetTradeActive() then
                    break
                end

                _G._isTradeActive = true

                if activeData.tradeId ~= lastTradeId then
                    lastTradeId = activeData.tradeId
                    lastAttemptTimes = {}
                end

                local users = tradeRep:TryIndex({ "active", "data", "users" })
                local players = tradeRep:TryIndex({ "active", "data", "players" })
                local lastChange = tradeRep:TryIndex({ "active", "data", "lastChange" })

                local mySlot = nil
                if type(users) == "table" then
                    for slotKey, uid in pairs(users) do
                        if tonumber(uid) == LocalPlayer.UserId then
                            mySlot = slotKey
                            break
                        end
                    end
                end

                local myPlayer = nil
                if type(players) == "table" and mySlot ~= nil then
                    myPlayer = players[mySlot] or players[tostring(mySlot)] or players[tonumber(mySlot)]
                end

                local offeredBrainrots = {}
                local offeredBases = {}
                local offeredGears = {}
                local offeredGearNameCounts = {}
                local anyOfferInTrade = false
                local allPlayersReady = true

                if type(players) == "table" then
                    for _, pData in pairs(players) do
                        if type(pData) == "table" then
                            if not pData.ready then
                                allPlayersReady = false
                            end
                            if type(pData.offer) == "table" then
                                for _, offerList in pairs(pData.offer) do
                                    if type(offerList) == "table" and next(offerList) ~= nil then
                                        anyOfferInTrade = true
                                    end
                                end
                            end
                        end
                    end
                end

                if type(myPlayer) == "table" and type(myPlayer.offer) == "table" then
                    if type(myPlayer.offer.brainrots) == "table" then
                        for _, bEntry in pairs(myPlayer.offer.brainrots) do
                            if type(bEntry) == "table" then
                                local bIndex = bEntry.IndexOnPlot or bEntry.podiumIndex or bEntry.Index
                                if bIndex ~= nil then
                                    offeredBrainrots[tostring(bIndex)] = true
                                end
                            end
                        end
                    end
                    if type(myPlayer.offer.baseSkins) == "table" then
                        for _, sEntry in pairs(myPlayer.offer.baseSkins) do
                            if type(sEntry) == "table" and type(sEntry.UUID) == "string" then
                                offeredBases[sEntry.UUID] = true
                            end
                        end
                    end
                    if type(myPlayer.offer.gears) == "table" then
                        for _, gEntry in pairs(myPlayer.offer.gears) do
                            if type(gEntry) == "table" then
                                if type(gEntry.UUID) == "string" and gEntry.UUID ~= "" then
                                    offeredGears[gEntry.UUID] = true
                                end
                                local gName = normalizeStr(gEntry.GearName or gEntry.Name or "")
                                if gName ~= "" then
                                    offeredGearNameCounts[gName] = (offeredGearNameCounts[gName] or 0) + 1
                                end
                            end
                        end
                    end
                end

                local stillNeedsAdding = false

                if type(myPlayer) == "table" and not myPlayer.ready and not myPlayer.accepted then
                    local podiums = playerSync:Get("AnimalPodiums")
                    if type(podiums) == "table" then
                        for podiumIndex, brainrot in pairs(podiums) do
                            local keyStr = tostring(podiumIndex)
                            if type(brainrot) == "table"
                                and not brainrot.Machine
                                and isTargetAnimal(brainrot)
                            then
                                if not offeredBrainrots[keyStr] then
                                    stillNeedsAdding = true
                                    local now = os.clock()
                                    if not lastAttemptTimes[keyStr] or (now - lastAttemptTimes[keyStr] >= 1.5) then
                                        lastAttemptTimes[keyStr] = now
                                        addAnimalToTrade(podiumIndex, brainrot)
                                        task.wait(1)
                                    end
                                end
                            end
                        end
                    end

                    local baseInv = playerSync:Get("BaseSkinInventory")
                    if type(uuid) == "string" and type(skinData) == "table" then
                    end
                    if type(baseInv) == "table" then
                        for uuid, skinData in pairs(baseInv) do
                            if type(uuid) == "string" and type(skinData) == "table" then
                                local skinName = skinData.SkinName
                                local tradable = true
                                if BaseSkinsModule and type(BaseSkinsModule.IsTradable) == "function" then
                                    local okT, resT = pcall(BaseSkinsModule.IsTradable, skinName)
                                    if okT then
                                        tradable = resT
                                    end
                                end
                                if type(skinName) == "string"
                                    and tradable
                                    and isTargetBase(skinData)
                                then
                                    if not offeredBases[uuid] then
                                        stillNeedsAdding = true
                                        local now = os.clock()
                                        if not lastAttemptTimes[uuid] or (now - lastAttemptTimes[uuid] >= 1.5) then
                                            lastAttemptTimes[uuid] = now
                                            addBaseSkinToTrade(uuid, {
                                                UUID = uuid,
                                                SkinName = skinName,
                                            })
                                            task.wait(1)
                                        end
                                    end
                                end
                            end
                        end
                    end

                    local ownedGears = {}
                    local seenSelKeys = {}

                    if TypeHandlers.Gear and type(TypeHandlers.Gear.FetchInventory) == "function" then
                        local okG, listG = pcall(TypeHandlers.Gear.FetchInventory, playerSync)
                        if okG and type(listG) == "table" then
                            for idx, item in ipairs(listG) do
                                if type(item) == "table" and type(item.Ref) == "table" then
                                    local sk = tostring(item.SelKey or idx)
                                    if not seenSelKeys[sk] then
                                        seenSelKeys[sk] = true
                                        table.insert(ownedGears, {
                                            selKey = item.SelKey or idx,
                                            ref = item.Ref,
                                        })
                                    end
                                end
                            end
                        end
                    end

                    if GearsModule and type(GearsModule.ListOwned) == "function" then
                        local okG, listG = pcall(GearsModule.ListOwned, playerSync)
                        if okG and type(listG) == "table" then
                            for idx, g in ipairs(listG) do
                                if type(g) == "table" and type(g.GearName) == "string" then
                                    local sk = type(g.UUID) == "string" and g.UUID ~= "" and g.UUID or ("gear_" .. g.GearName .. "_" .. tostring(idx))
                                    if not seenSelKeys[sk] then
                                        seenSelKeys[sk] = true
                                        table.insert(ownedGears, {
                                            selKey = sk,
                                            ref = {
                                                GearName = g.GearName,
                                                UUID = g.UUID,
                                            },
                                        })
                                    end
                                end
                            end
                        end
                    end

                    local rawGearInv = playerSync:Get("GearInventory") or playerSync:Get("Gears")
                    if type(rawGearInv) == "table" then
                        for k, v in pairs(rawGearInv) do
                            local gName = type(v) == "table" and (v.GearName or v.Name) or (type(k) == "string" and k)
                            local uuid = type(v) == "table" and v.UUID or (type(k) == "string" and k)
                            if gName and type(gName) == "string" then
                                local sk = (uuid and tostring(uuid)) or ("raw_" .. gName .. "_" .. tostring(k))
                                if not seenSelKeys[sk] then
                                    seenSelKeys[sk] = true
                                    table.insert(ownedGears, {
                                        selKey = sk,
                                        ref = {
                                            GearName = gName,
                                            UUID = uuid,
                                        },
                                    })
                                end
                            end
                        end
                    end

                    local allocatedOfferedCounts = {}

                    for _, gearEntry in ipairs(ownedGears) do
                        if isTargetGear(gearEntry.ref) then
                            local uuid = (type(gearEntry.ref) == "table" and type(gearEntry.ref.UUID) == "string" and gearEntry.ref.UUID ~= "") and gearEntry.ref.UUID or nil
                            local gNameNorm = normalizeStr(type(gearEntry.ref) == "table" and (gearEntry.ref.GearName or gearEntry.ref.Name) or gearEntry.ref)
                            
                            local isAlreadyInTrade = false
                            if uuid and offeredGears[uuid] then
                                isAlreadyInTrade = true
                            elseif gNameNorm ~= "" then
                                local currentOffered = offeredGearNameCounts[gNameNorm] or 0
                                local currentAllocated = allocatedOfferedCounts[gNameNorm] or 0
                                if currentAllocated < currentOffered then
                                    allocatedOfferedCounts[gNameNorm] = currentAllocated + 1
                                    isAlreadyInTrade = true
                                end
                            end

                            if not isAlreadyInTrade then
                                stillNeedsAdding = true
                                local itemKey = uuid or tostring(gearEntry.selKey)
                                local now = os.clock()
                                if not lastAttemptTimes[itemKey] or (now - lastAttemptTimes[itemKey] >= 1.5) then
                                    lastAttemptTimes[itemKey] = now
                                    addGearToTrade(gearEntry.selKey, gearEntry.ref)
                                    task.wait(1)
                                end
                            end
                        end
                    end
                end

                if not stillNeedsAdding and type(lastChange) == "number" then
                    local serverNow = workspace:GetServerTimeNow()
                    local cooldownDone = (serverNow >= lastChange + 5.15)

                    if cooldownDone and anyOfferInTrade and (os.clock() - lastActionClock >= 0.8) then
                        local needClick = false
                        if type(myPlayer) == "table" then
                            if not allPlayersReady and not myPlayer.ready then
                                needClick = true
                            elseif allPlayersReady and not myPlayer.accepted then
                                needClick = true
                            end
                        end

                        if needClick then
                            lastActionClock = os.clock()
                            fireReadyOrAcceptButton()
                        end
                    end
                end

                task.wait(0.2)
            end
        end)
        _G._isTradeActive = false
        automationRunning = false
    end)
end

local TradeGuiNames = { "TradeLiveTrade", "TradePrompts", "TradeSelection" }
local HiddenRootNames = { TradeLiveTrade = true, TradePrompts = true, TradeSelection = true }
local hideTradeUi = false
local hidePromptsUi = false
local savedGuiVisible = {}
local savedPromptsEnabled = {}
local hookedGuis = {}

local function getRootGuiName(inst)
    local cur = inst
    while cur and cur.Parent and cur.Parent ~= PlayerGui do
        cur = cur.Parent
    end
    return cur and cur.Name or ""
end

local function shouldForceHide(inst)
    local root = getRootGuiName(inst)
    if hideTradeUi then
        return HiddenRootNames[root] == true
    end
    if hidePromptsUi then
        return root == "TradePrompts"
    end
    return false
end

local function hookTradeGuiObject(desc)
    if hookedGuis[desc] then
        return
    end
    hookedGuis[desc] = true
    if desc:IsA("ScreenGui") then
        addConn(desc:GetPropertyChangedSignal("Enabled"):Connect(function()
            if desc.Enabled and shouldForceHide(desc) then
                desc.Enabled = false
            end
        end))
    elseif desc:IsA("GuiObject") then
        addConn(desc:GetPropertyChangedSignal("Visible"):Connect(function()
            if desc.Visible and shouldForceHide(desc) then
                desc.Visible = false
            end
        end))
    end
end

local function hideGuiObject(desc)
    if desc:IsA("GuiObject") then
        if savedGuiVisible[desc] == nil then
            savedGuiVisible[desc] = desc.Visible
        end
        desc.Visible = false
    end
    hookTradeGuiObject(desc)
end

local function applyHideToGui(tradeGui)
    if tradeGui:IsA("ScreenGui") then
        if savedPromptsEnabled[tradeGui] == nil then
            savedPromptsEnabled[tradeGui] = tradeGui.Enabled
        end
        tradeGui.Enabled = false
    end
    hookTradeGuiObject(tradeGui)
    for _, desc in ipairs(tradeGui:GetDescendants()) do
        hideGuiObject(desc)
    end
end

local function applyTradeUiHidden()
    if hideTradeUi then
        for _, name in ipairs(TradeGuiNames) do
            local tradeGui = PlayerGui:FindFirstChild(name)
            if tradeGui then
                applyHideToGui(tradeGui)
            end
        end
    end
end

local function restoreTradeUi()
    for inst, vis in pairs(savedGuiVisible) do
        if inst and inst.Parent then
            pcall(function()
                inst.Visible = vis
            end)
        end
    end
    savedGuiVisible = {}
    for gui, en in pairs(savedPromptsEnabled) do
        if gui and gui.Parent then
            pcall(function()
                gui.Enabled = en
            end)
        end
    end
    savedPromptsEnabled = {}
end

local function updateTradeUiState()
    local wasTargetActive = hideTradeUi
    hideTradeUi = isTargetTradeActive()

    if hideTradeUi then
        applyTradeUiHidden()
    elseif wasTargetActive then
        restoreTradeUi()
    end

    if not isTargetTradeRecent() and _G._isFakeCarrying then
        stopFakeCarry()
    end
end

addConn(PlayerGui.DescendantAdded:Connect(function(desc)
    if desc:IsA("GuiObject") or desc:IsA("ScreenGui") then
        local root = getRootGuiName(desc)
        if hideTradeUi and HiddenRootNames[root] then
            hookTradeGuiObject(desc)
            if desc:IsA("ScreenGui") then
                desc.Enabled = false
            else
