local function formatIncome(n)
    if not n or type(n) ~= "number" or n <= 0 then return nil end
    local function fmt(val, unit)
        if val == math.floor(val) then
            return string.format("%d%s/s", val, unit)
        else
            return string.format("%.1f%s/s", val, unit)
        end
    end
    if n >= 1e12 then
        return fmt(n / 1e12, "T")
    elseif n >= 1e9 then
        return fmt(n / 1e9, "B")
    elseif n >= 1e6 then
        return fmt(n / 1e6, "M")
    elseif n >= 1e3 then
        return fmt(n / 1e3, "K")
    elseif n == math.floor(n) then
        return string.format("%d/s", n)
    else
        return string.format("%.1f/s", n)
    end
end

