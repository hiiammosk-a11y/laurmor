local function findAnimalFromPrompt(prompt)
    if not prompt then return nil end

    local spawnPart = prompt:FindFirstAncestorWhichIsA("BasePart")
    local plot = getMyPlot()
    if not plot then return nil end

    local animalName = prompt.ObjectText
    if type(animalName) == "string" and animalName ~= "" then
        local direct = plot:FindFirstChild(animalName)
        if direct and direct:IsA("Model") then
            return direct
        end
        for _, child in ipairs(plot:GetChildren()) do
            if child:IsA("Model") and not child:GetAttribute("FakeGhost") and string.find(string.lower(child.Name), string.lower(animalName), 1, true) then
                return child
            end
        end
    end

    if spawnPart then
        local best = nil
        local bestDist = 14
        for _, child in ipairs(plot:GetChildren()) do
            if child:IsA("Model") and not child:GetAttribute("FakeGhost") and child.Name ~= "AnimalPodiums" and child.Name ~= "Structure" and child.Name ~= "PlotSign" then
                local p = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                if p then
                    local d = (p.Position - spawnPart.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = child
                    end
                end
            end
        end
        return best
    end

    return nil
end

